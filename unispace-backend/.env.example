# env example buat backend nya

# app_env buat development, production
# bedanya : 
# development : log nya lebih verbose, error nya lebih detail, hotreload etc
# development : khsus buat prod gaada hot reload
APP_ENV=development

# ini port backend buat si Fe nembak or redirect ke sini
PORT=3001

# fe url buat CORS
FRONTEND_URL=http://localhost:3000

# database config ntar di prod ganti ke link url live db nya
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Password awal untuk akun yang dibuat/reset admin.
DEFAULT_USER_PASSWORD=change_me_24_char_passwd

# Akun ADMIN lokal dibuat `npm run db:seed`.
# ADMIN_SEED_PASSWORD opsional; kosong, seed memakai DEFAULT_USER_PASSWORD.
ADMIN_SEED_NAME=Administrator Unispace
ADMIN_SEED_IDENTITY_NUMBER=00000000
ADMIN_SEED_EMAIL=admin@unispace.local
ADMIN_SEED_PASSWORD=change_me_admin_password

# jwt
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# minio config (ini default nanti bisa diganti )
STORAGE_PROVIDER=MINIO
# URL publik backend hingga prefix API. Digunakan untuk URL proxy gambar fasilitas.
PUBLIC_API_URL=http://localhost:3001/api/v1
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=unispace-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_minio
S3_FORCE_PATH_STYLE=true
